{
  "name": "roblox-icon-renderer",
  "version": "0.9.1",
  "description": "Desktop icon renderer for Roblox .rbxm/.rbxmx/.obj files with post-processing and VFX",
  "main": "main.js",
  "desktopName": "roblox-icon-renderer.desktop",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node test/parsers.test.js && node test/anim.test.js && node test/scene.test.js && node test/features.test.js && node test/mcp.test.js",
    "test:render": "electron test/render.cjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "release": "node -e \"const v='v'+require('./package.json').version;require('child_process').execSync('git tag '+v+' && git push origin '+v,{stdio:'inherit'})\""
  },
  "build": {
    "appId": "com.roblox-icon-renderer.app",
    "productName": "Roblox Icon Renderer",
    "asar": false,
    "files": [
      "main.js",
      "preload.cjs",
      "index.html",
      "src/**/*",
      "build/icon.png",
      "node_modules/three/package.json",
      "node_modules/three/build/**/*",
      "node_modules/fzstd/**/*",
      "node_modules/gifenc/package.json",
      "node_modules/gifenc/LICENSE.md",
      "node_modules/gifenc/dist/gifenc.esm.js",
      "node_modules/mediabunny/package.json",
      "node_modules/mediabunny/LICENSE",
      "node_modules/mediabunny/dist/bundles/mediabunny.min.mjs",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "syncDesktopName": true,
      "artifactName": "Roblox-Icon-Renderer.${ext}"
    },
    "icon": "build/icon.png",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Roblox Icon Renderer"
    },
    "artifactName": "Roblox-Icon-Renderer-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "ColderThiago13",
        "repo": "Roblox-Icon-Renderer-App",
        "releaseType": "release"
      }
    ]
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fzstd": "^0.1.1",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.61.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "author": "ColderThiago13"
}
